DATABASE_URL=postgresql+psycopg://ai_slop:ai_slop_local@localhost:5432/ai_slop
POSTGRES_USER=ai_slop
POSTGRES_PASSWORD=ai_slop_local
POSTGRES_DB=ai_slop
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=ai-slop-backend
JWT_AUDIENCE=ai-slop-api

# Reserved for the upcoming SeaweedFS S3 integration (not needed for authentication).
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=ai-slop
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Stage 1 infrastructure; mock is the default (no paid API calls).
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
LOG_LEVEL=INFO
EXTERNAL_PROVIDERS_MODE=mock
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Optional full DSN for the API container (use host postgres, port 5432).
# Required if POSTGRES_PASSWORD contains URL-special characters; percent-encode them.
# DOCKER_DATABASE_URL=postgresql+psycopg://ai_slop:ai_slop_local@postgres:5432/ai_slop

# Stage 3: only required in live mode; choose a Structured Outputs capable model.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
