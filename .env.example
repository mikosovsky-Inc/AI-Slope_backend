DATABASE_URL=postgresql+psycopg://ai_slop:ai_slop_local@localhost:5432/ai_slop
POSTGRES_USER=ai_slop
POSTGRES_PASSWORD=ai_slop_local
POSTGRES_DB=ai_slop
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=ai-slop-backend
JWT_AUDIENCE=ai-slop-api

# Stage 11: native Python defaults to local; Compose always uses SeaweedFS S3.
STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=/absolute/private/path/assets
STORAGE_MAX_BYTES=104857600
S3_PORT=8333
S3_URL_SECONDS=300
S3_TIMEOUT_SECONDS=10
# S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=ai-slop
S3_REGION=us-east-1
# Local development credentials; replace for deployed installations.
S3_ACCESS_KEY_ID=ai-slop-local
S3_SECRET_ACCESS_KEY=ai-slop-local-secret

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Stage 1 infrastructure; mock is the default (no paid API calls).
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
LOG_LEVEL=INFO
EXTERNAL_PROVIDERS_MODE=mock
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Optional full DSN for the API container (use host postgres, port 5432).
# Required if POSTGRES_PASSWORD contains URL-special characters; percent-encode them.
# DOCKER_DATABASE_URL=postgresql+psycopg://ai_slop:ai_slop_local@postgres:5432/ai_slop

# Stage 3: only required in live mode; choose a Structured Outputs capable model.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Operator-supplied planning estimates, NOT actual provider prices/billing.
DIRECTOR_IMAGE_ESTIMATE_USD=0.005
DIRECTOR_VIDEO_SECOND_ESTIMATE_USD=0.01
DIRECTOR_VISUAL_BUDGET_FRACTION=0.5

# Stage 12: used only for explicit generation operations in live mode.
RUNPOD_API_KEY=
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=
RUNPOD_IMAGE_MODEL=
RUNPOD_VIDEO_MODEL=
RUNPOD_TIMEOUT_SECONDS=20
RUNPOD_STATUS_MAX_RETRIES=2
RUNPOD_EXECUTION_TIMEOUT_MS=600000
RUNPOD_JOB_TTL_MS=3600000

# Stage 13: live TTS requires a key, model, voice and operator-supplied USD estimate.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_MAX_RESPONSE_BYTES=16777216
ELEVENLABS_SEND_LANGUAGE_CODE=true
# TTS_USD_PER_1000_CHARACTERS=0.000000

# Stage 14: worker and durable DB -> Redis dispatcher.
TASK_DISPATCH_INTERVAL_SECONDS=2
TASK_LEASE_SECONDS=300
# TASKS_EAGER is reserved for service regression tests; keep false outside tests.
TASKS_EAGER=false

# Stage 15: FFmpeg renderer (also install ffprobe and DejaVu fonts locally)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
RENDER_TIMEOUT_SECONDS=600
RENDER_THREADS=2
RENDER_MAX_INPUT_BYTES=536870912

# Stage 16: technical quality control and bounded scene repairs
QUALITY_DURATION_TOLERANCE_SECONDS=1.0
QUALITY_MAX_SCENE_RETRIES=2
QUALITY_TIMEOUT_SECONDS=180
QUALITY_REPAIR_TIMEOUT_SECONDS=3600

# Stage 17: daily planner for active channels (no publishing)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_TIMEZONE=UTC
SCHEDULER_BATCH_SIZE=100
SCHEDULER_MAX_IDEA_BATCHES_PER_DAY=2
